# ──────────────────────────────────────────────────────────────────────────────
# Splitty — environment variables
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Both variables are REQUIRED — the app will fail to start without them.
# ──────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
#
# Splitty uses the Neon serverless HTTP driver, so a Neon pooled URL is the
# easiest path. Any Postgres reachable over a standard connection string will
# also work.
#
# Example (Neon, pooled):
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session JWTs (HS256).
# MUST be at least 32 characters long.
#
# Generate a strong one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
